# Copia este archivo como .env y reemplaza los valores:
#   cp .env.example .env
# NUNCA subas el .env real al repositorio (ya está en .gitignore).

# --- MySQL ---
DB_NAME=chatbot_solvyx
DB_USER=solvyx
DB_PASSWORD=cambia_esta_contrasena
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena_root

# --- DeepSeek ---
API_KEY=sk-tu-api-key-de-deepseek

# --- Opcionales ---
# Puerto de la VPS donde se expone la API (el contenedor siempre escucha en 8080)
APP_PORT=8080
TZ=America/Mexico_City

# --- Solo para correr la app SIN Docker (mvn spring-boot:run) ---
# Con docker compose NO hacen falta: el compose arma DATABASE_URL apuntando al servicio "db".
# DATABASE_URL=jdbc:mysql://localhost:3306/chatbot_solvyx
# DATABASE_USERNAME=solvyx
# DATABASE_PASSWORD=cambia_esta_contrasena

meta {
  name: 06 - Enviar Mensaje - Falta userId
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/chat/mensaje
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Juan Perez",
    "mensaje": "Hola"
  }
}

tests {
  test("status is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("el error menciona userId", function () {
    expect(res.getBody().mensaje.toLowerCase()).to.include("userid");
  });
}

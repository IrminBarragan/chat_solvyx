meta {
  name: 03 - Enviar Mensaje - Mensaje vacio
  type: http
  seq: 3
}

post {
  url: {{base-url}}/api/chat/mensaje
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "user-001",
    "nombre": "Juan Perez",
    "mensaje": ""
  }
}

tests {
  test("status is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  
  test("incluye mensaje de error de validacion", function () {
    expect(res.getBody()).to.have.property("mensaje");
    expect(res.getBody().status).to.equal(400);
  });
}

meta {
  name: 02 - Enviar Mensaje - Continuar conversacion
  type: http
  seq: 2
}

post {
  url: {{base-url}}/api/chat/mensaje
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": "user-001",
    "nombre": "Juan Perez",
    "mensaje": "Y si la ansiedad no se me quita con eso, que mas puedo intentar?"
  }
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("continua en el mismo historial que la peticion anterior", function () {
    expect(res.getBody().historialId).to.equal(bru.getVar("historialId"));
  });
}
